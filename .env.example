# ============================================================
# Supabase Configuration (Primary Cloud Database & Auth)
# ============================================================
# 1. Create a project at https://supabase.com
# 2. Run supabase_schema.sql in Supabase SQL Editor
# 3. Copy Project URL and anon/publishable key from:
#    Project Settings -> API
# ============================================================
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ============================================================
# Google Apps Script Web App URL (Fallback Cloud Database)
# ============================================================
# After deploying the GoogleAppsScript.js as a Web App:
#   1. Go to https://script.google.com
#   2. Create new project, paste GoogleAppsScript.js content
#   3. Deploy -> New Deployment -> Web App
#      - Execute as: Me
#      - Who has access: Anyone
#   4. Copy the Web App URL and paste it below
# ============================================================
VITE_GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
